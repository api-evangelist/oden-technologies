          "name": "Execute a dashboard",
          "request": {
            "name": "Execute a dashboard",
            "description": {
              "content": "Execute every module in a dashboard with shared time-range and filter\noverrides, returning the columns and rows produced by each module.\n\nModules execute in parallel and are reported in the dashboard's stored\nmodule order. Per-module failures (parse, dispatch) land in the\n`error` field of that module's result; siblings continue to run.\n\nKnown v1 limitations:\n- Template variables (`{var_name}` in stored OQL) are not substituted\n  server-side. Modules containing unsubstituted placeholders will\n  fail at parse time.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "dashboard",
                "execute"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dashboard\": {\n    \"id\": \"<uuid>\"\n  },\n  \"range\": {\n    \"start\": \"<dateTime>\",\n    \"end\": \"<dateTime>\",\n    \"anchor\": \"<string>\",\n    \"offset\": \"<string>\",\n    \"timezone\": \"<string>\"\n  },\n  \"filters\": {\n    \"shifts\": [\n      \"<integer>\",\n      \"<integer>\"\n    ],\n    \"product_ids\": [\n      \"<uuid>\",\n      \"<uuid>\"\n    ],\n    \"product_attribute_value_ids\": [\n      \"<uuid>\",\n      \"<uuid>\"\n    ],\n    \"scrap_categories\": [\n      \"<uuid>\",\n      \"<uuid>\"\n    ],\n    \"states\": {\n      \"state_types\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"state_category_and_reasons\": [\n        {\n          \"state_category\": \"<integer>\",\n          \"state_reason\": \"<string>\"\n        },\n        {\n          \"state_category\": \"<integer>\",\n          \"state_reason\": \"<string>\"\n        }\n      ]\n    },\n    \"custom_intervals\": [\n      {\n        \"type\": \"<string>\",\n        \"value_contains\": \"<string>\"\n      },\n      {\n        \"type\": \"<string>\",\n        \"value_contains\": \"<string>\"\n      }\n    ]\n  }\n}",
              "options": {
